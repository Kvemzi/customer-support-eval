# =============================================================================
#  Copy to `.env` and fill in real values:   cp .env.example .env
#  NEVER commit the real `.env` file.
# =============================================================================

# --- OpenAI (used by the SUT AND by DeepEval's judge model) -------------------
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- SUT configuration --------------------------------------------------------
# openai | mock | http | auto  (auto = openai if a key exists, otherwise mock)
SUT_BACKEND=auto
SUT_MODEL=gpt-4o-mini
SUT_TEMPERATURE=0.3
SUT_MEMORY_MAX_TURNS=10
SUT_RETRIEVAL_TOP_K=2

# Optional override of the knowledge-base file location
# SUT_KB_PATH=data/knowledge_base/policies.json

# Only for SUT_BACKEND=http
SUT_HTTP_ENDPOINT=http://localhost:8000/chat
SUT_HTTP_TIMEOUT=30

# --- Evaluation ---------------------------------------------------------------
# Judge model used by DeepEval metrics
EVAL_JUDGE_MODEL=gpt-4o-mini
# Output folder for JSON run reports
EVAL_REPORTS_DIR=reports

# --- DeepEval -----------------------------------------------------------------
DEEPEVAL_TELEMETRY_OPT_OUT=YES